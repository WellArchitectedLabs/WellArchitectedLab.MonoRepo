FROM bitnami/postgresql:15.5.0-debian-11-r0

# Install additional utilities if needed
USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy the sanity check script
COPY postgres-sanity-guard.sh /usr/local/bin/postgres-sanity-guard.sh

# Make it executable
RUN chmod +x /usr/local/bin/postgres-sanity-guard.sh

# Switch back to non-root user for security
USER 1001

# Set the entrypoint
ENTRYPOINT ["/usr/local/bin/postgres-sanity-guard.sh"]