FROM docker.io/bitnami/minideb:bullseye

# Install PostgreSQL client tools
USER root
RUN install_packages \
    ca-certificates \
    curl \
    postgresql-client \
    && apt-get clean && rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Copy the sanity check script
COPY postgres-sanity-guard.sh /usr/local/bin/postgres-sanity-guard.sh

# Make it executable
RUN chmod +x /usr/local/bin/postgres-sanity-guard.sh

# Create non-root user
RUN useradd -r -u 1001 -g root postgres-guard

# Switch to non-root user for security
USER 1001

# Set the entrypoint
ENTRYPOINT ["/usr/local/bin/postgres-sanity-guard.sh"]