<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet identity -->
    <PackageId>MasterData.Client</PackageId>
    <Version>$(Version)</Version>

    <!-- Ownership -->
    <Authors>Mohamed Baligh H.</Authors>
    <Company>devpragmax</Company>

    <!-- Presentation -->
    <Title>Master Data Client SDK</Title>
    <Description>
      Official .NET client SDK for Master Data API.
      Provides strongly-typed APIs, client registration helpers,
      and fluent first-class integration with Master Data services.
    </Description>
    <Summary>.NET client library for Master Data APIs</Summary>
    <PackageTags>master-data sdk client api dotnet</PackageTags>

    <!-- Links -->
    <PackageProjectUrl>
      https://github.com/WellArchitectedLabs/WellArchitectedLab.MonoRepo
    </PackageProjectUrl>

    <RepositoryUrl>
      https://github.com/WellArchitectedLabs/WellArchitectedLab.MonoRepo
    </RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Legal -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RequireLicenseAcceptance>false</RequireLicenseAcceptance>

    <!-- NuGet UI assets -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Release notes -->
    <PackageReleaseNotes>
      See https://github.com/WellArchitectedLabs/WellArchitectedLab.MonoRepo/releases
    </PackageReleaseNotes>

    <!-- Packaging -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet assets -->
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Refit" Version="10.0.1" />
    <PackageReference Include="Refit.HttpClientFactory" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\MasterData.Domain.csproj" />
  </ItemGroup>

</Project>
